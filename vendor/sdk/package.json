{
  "name": "@adestack/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "ADE 행동 수집 SDK — Mixpanel SDK 위에 ADE 계약을 얹는다. 벤더에 없는 기능은 packages/ 의 확장으로 붙인다",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm -r run build && tsc -p tsconfig.build.json",
    "test": "pnpm --silent run build && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml \"tests/unit/*.test.mjs\" \"packages/*/test/*.test.mjs\"",
    "test:e2e": "node tests/browser/scripts/build-fixture.mjs && playwright test -c tests/browser/playwright.config.ts",
    "test:chromium": "node tests/browser/scripts/build-fixture.mjs && playwright test -c tests/browser/playwright.config.ts --project=chromium",
    "test:headed": "node tests/browser/scripts/build-fixture.mjs && playwright test -c tests/browser/playwright.config.ts --project=chromium --headed",
    "test:report": "playwright show-report tests/browser/playwright-report",
    "browsers:install": "playwright install",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm run typecheck && pnpm run test && node scripts/check-version-pin.mjs"
  },
  "dependencies": {
    "@adestack/contract": "workspace:0.1.0",
    "@adestack/name": "workspace:0.1.0",
    "mixpanel-browser": "2.82.1"
  },
  "devDependencies": {
    "@adestack/extensions": "workspace:*",
    "@amplitude/plugin-autocapture-browser": "1.29.0",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "@adestack:registry": "https://gitlab.hectoai.co.kr/api/v4/projects/${CI_PROJECT_ID}/packages/npm/"
  }
}
